@startuml
!include estilo.iuml
left to right direction
class Exception <<java.lang>>
class RuntimeException <<java.lang>>
abstract class GestorVerdeException {
  #GestorVerdeException(mensaje)
  #GestorVerdeException(mensaje, causa)
  +{abstract} getMensajeParaUsuario() : String
}
class ReglaNegocioException {
  -codigoRegla : String
  -accionCorrectiva : String
  -idLote, idUbicacion, cantidadPretendida
  +conDatos(lote, ubicacion, cantidad) : ReglaNegocioException
}
class DatosInvalidosException
class AutenticacionException
class SesionExpiradaException
class PersistenciaException {
  +getMensajeParaUsuario()  «traduce SQLException»
}
class EstructuraVaciaException
class "Consola.FinDeEntradaException" as Fin
Exception <|-- GestorVerdeException
GestorVerdeException <|-- ReglaNegocioException
GestorVerdeException <|-- DatosInvalidosException
GestorVerdeException <|-- AutenticacionException
AutenticacionException <|-- SesionExpiradaException
GestorVerdeException <|-- PersistenciaException
Exception <|-- RuntimeException
RuntimeException <|-- EstructuraVaciaException
RuntimeException <|-- Fin
note top of GestorVerdeException
  Verificadas (checked): errores
  previsibles que la interfaz
  debe informar al usuario.
end note
note bottom of EstructuraVaciaException
  No verificadas: errores de
  programación o fin de la entrada.
end note
@enduml
